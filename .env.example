# Path to the Access database. Relative paths are resolved from this folder.
ACCESS_DB_PATH=./devdb.mdb

# OLE DB provider. Jet 4.0 handles .mdb files; use Microsoft.ACE.OLEDB.12.0 for .accdb.
ACCESS_PROVIDER=Microsoft.Jet.OLEDB.4.0

# Optional: full path to cscript.exe. Defaults to the 32-bit one in SysWOW64, because
# the Jet/ACE drivers installed on this machine are 32-bit only.
# ACCESS_CSCRIPT=C:\Windows\SysWOW64\cscript.exe

# Secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
